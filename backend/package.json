{
  "name": "dms-backend",
  "version": "1.0.0",
  "description": "Document Management System Backend",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "typeorm migration:run -d src/config/database.ts",
    "db:migrate:generate": "typeorm migration:generate -d src/config/database.ts",
    "db:rollback": "typeorm migration:revert -d src/config/database.ts",
    "db:seed": "tsx src/seeds/seed.ts",
    "queue:start": "tsx src/infrastructure/queue/workers/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "document",
    "management",
    "ocr",
    "extraction"
  ],
  "author": "sumayyahz",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.1.6",
    "typeorm": "^0.3.16",
    "pg": "^8.11.1",
    "redis": "^4.6.7",
    "bull": "^4.11.4",
    "uuid": "^9.0.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.4.0",
    "winston": "^3.10.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "xlsx": "^0.18.5",
    "tesseract.js": "^4.1.1",
    "sharp": "^0.32.6",
    "minio": "^7.1.0",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "compression": "^1.7.4",
    "swagger-ui-express": "^4.6.3",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.5",
    "@types/multer": "^1.4.7",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.3",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "jest": "^29.6.3",
    "ts-jest": "^29.1.1",
    "tsx": "^3.12.7",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

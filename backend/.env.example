# Backend Environment Variables

# Application
NODE_ENV=development
PORT=5000
APP_NAME=Document Management System

# Database
DATABASE_URL=postgresql://dms_user:dms_password@localhost:5432/dms_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=dms_user
DATABASE_PASSWORD=dms_password
DATABASE_NAME=dms_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=52428800

# MinIO (optional - for cloud storage)
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=dms-documents
MINIO_USE_SSL=false

# OCR & Text Extraction
OCR_ENABLED=true
PDF_EXTRACTION_ENABLED=true

# OpenAI (optional - for metadata extraction)
OPENAI_ENABLED=false
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4

# Logging
LOG_LEVEL=debug

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@dms.com

# Cors
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Session
SESSION_SECRET=your-session-secret-key
